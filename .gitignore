# secrets
.env
.env.*
!.env.example

# local KB study copy + API cache + dev bundles (KB must not be redistributed)
kb_snapshot/
.cache/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# logs / outputs
logs/
*.log
outputs/
.DS_Store
__MACOSX/

# archives (ima-skill/ itself IS committed, unmodified, per WORKFLOW v4)
*.zip

# demo data kit is tracked on purpose (synthetic store data, no KB content);
# data/demo/inputs/poi_cache/ files from fetch_poi.py may be committed too
!data/demo/
!data/demo/**

# eval reports from real runs contain KB-derived copy: never commit
eval/
