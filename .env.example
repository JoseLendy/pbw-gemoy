# Copy to .env and fill in. NEVER commit .env. Never print these values.
# ima (only the P1 data workstream needs these)
IMA_OPENAPI_CLIENTID=your-client-id
IMA_OPENAPI_APIKEY=your-api-key

# LLM provider (OpenAI-compatible endpoint, e.g. DashScope/Qwen or DeepSeek)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-key
LLM_MODEL=qwen-plus
LLM_MODEL_FAST=qwen-turbo

# KB data source: ima (live API) | hybrid (live API + local mirror fallback) | local (mirror only, dev)
KB_BACKEND=ima
KB_LOCAL_DIR=kb_snapshot/kb_v7

# Optional: Amap (高德) Web Service key for scripts/fetch_poi.py (real POI around each demo store).
# Leave empty to use the generated POI fixtures. Same handling as the ima keys: never print or commit it.
AMAP_KEY=

# Two-temperature design (Phase 2/4). Facts and checkers default to 0; the writer is the only creative stage.
# Phase 5 eval (2026-10-23, 朋友圈, 12 stores): WRITER_TEMPERATURE=0.85 kept. Fixing the writer brief and two checker
# false positives took the pass rate from 3/12 to 9/12 within 2 rewrites at 0.85; the remaining failures were brief /
# judge issues, not randomness, so 0.7 was not tried (it would also raise peer similarity).
# FACT_TEMPERATURE=0
WRITER_TEMPERATURE=0.85
# CHECK_TEMPERATURE=0
# Stores generated at the same time in generate_batch / prepare_today (default 4).
# BATCH_MAX_WORKERS=4
# Per-product fact cache on disk under runs/cache/ (default on for real deps).
# FACT_CACHE_DISK=1
# 8E similarity threshold (default 0.55)
# SIMILARITY_THRESHOLD=0.55
