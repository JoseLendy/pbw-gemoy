# Copy to .env and fill in. NEVER commit .env.
IMA_OPENAPI_CLIENTID=your-client-id
IMA_OPENAPI_APIKEY=your-api-key

# LLM provider (OpenAI-compatible endpoint, e.g. DashScope/Qwen or DeepSeek)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-key
LLM_MODEL=qwen-plus
